# ==========================================
# BARKA SOLUTIONS S.A.S - ENV CONFIGURATION
# ==========================================

# Port & Node Environment (handled automatically by AI Studio)
NODE_ENV="development"
PORT=3000

# Application Public URL
APP_URL="https://ais-dev-6n5in2drgptlcbz4o3yjuz-634377365487.europe-west1.run.app"

# JWT Authentication Secret for Admin & Editor tokens (MANDATORY IN PRODUCTION - min 32 chars)
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Optional: Initial Bootstrap Passwords (if database is empty on first boot)
# If left empty, a secure cryptographically random password is generated and logged once.
ADMIN_INITIAL_PASSWORD=""
EDITOR_INITIAL_PASSWORD=""

# PostgreSQL Database (Optional: falls back to persistent disk store if not set)
DATABASE_URL="postgresql://user:password@localhost:5432/barkasolutions"

# =========================================================================
# NOTIFICATION RECIPIENTS (ADMINISTRATEURS BARKA SOLUTIONS S.A.S)
# Les devis et formulaires de contact sont envoyés à ces adresses :
# =========================================================================
ADMIN_NOTIFICATION_EMAILS="direction@barkasolutions.org,kouchoumichel@yahoo.fr"

# =========================================================================
# EMAIL SENDING SYSTEM (CHOISIR L'UNE DES OPTIONS CI-DESSOUS)
# Le système détecte automatiquement le fournisseur actif.
# =========================================================================

# OPTION 1 : SMTP Standard (Gmail, Brevo SMTP, SendGrid SMTP, OVH, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@barkasolutions.org"
SMTP_PASS=""
SMTP_FROM_NAME="BARKA SOLUTIONS S.A.S"
SMTP_FROM_EMAIL="direction@barkasolutions.org"
SMTP_FROM="BARKA SOLUTIONS <direction@barkasolutions.org>"

# OPTION 2 : Resend API (Alternative moderne & haute délivrabilité)
# RESEND_API_KEY=""

# OPTION 3 : Brevo / Sendinblue REST API
# BREVO_API_KEY=""

# OPTION 4 : SendGrid REST API
# SENDGRID_API_KEY=""

# OPTION 5 : Mailgun REST API
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN="mg.barkasolutions.org"

# Gemini API Key (managed by platform)
GEMINI_API_KEY=""
