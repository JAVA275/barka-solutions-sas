# =========================================================================
# BARKA SOLUTIONS S.A.S — FICHIER DE CONFIGURATION D'ENVIRONNEMENT (.env)
# =========================================================================
# Instructions :
# 1. Copiez ce fichier vers ".env" dans votre environnement local ou serveur.
# 2. Remplissez les variables obligatoires pour la mise en production.
# 3. Ne committez JAMAIS de vrais mots de passe ou clés d'API dans Git.
# =========================================================================

# -------------------------------------------------------------------------
# 1. ENVIRONNEMENT SYSTÈME & SERVEUR
# -------------------------------------------------------------------------
# "development" ou "production"
NODE_ENV="production"
PORT=3000

# URL publique de votre application en production (sans slash final)
APP_URL="https://barka-solutions-sas.vercel.app"

# -------------------------------------------------------------------------
# 2. SÉCURITÉ DE L'AUTHENTIFICATION & SESSIONS JWT
# -------------------------------------------------------------------------
# OBLIGATOIRE EN PRODUCTION : Clé secrète de signature cryptographique (HMAC-SHA256).
# DOIT comporter au minimum 32 caractères aléatoires et complexes.
# Génération recommandée via terminal : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Durée de validité des sessions utilisateurs (ex: "8h", "24h", "7d")
JWT_EXPIRES_IN="8h"

# Mots de passe initiaux pour l'amorçage automatique des comptes administrateurs
# (Utilisé uniquement si la table des utilisateurs est vide au premier lancement)
# Si laissé vide, un mot de passe temporaire fort et aléatoire sera généré et consigné dans les logs.
ADMIN_INITIAL_PASSWORD=""
EDITOR_INITIAL_PASSWORD=""

# -------------------------------------------------------------------------
# 3. BASE DE DONNÉES POSTGRESQL (OBLIGATOIRE EN PRODUCTION SERVERLESS / VERCEL)
# -------------------------------------------------------------------------
# Chaîne de connexion PostgreSQL (Neon, Supabase, AWS RDS, Railway, etc.)
# En production, PostgreSQL est indispensable pour la persistance entre les conteneurs lambdas.
# Exemple Neon/Supabase : postgresql://user:password@ep-cool-fog-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://utilisateur:motdepasse@hote-postgresql:5432/nom_de_la_base?sslmode=require"

# -------------------------------------------------------------------------
# 4. NOTIFICATIONS ADMINISTRATEURS (DESTINATAIRES DES DEVIS & MESSAGES)
# -------------------------------------------------------------------------
# Liste des adresses emails séparées par des virgules recevant les alertes instantanées
ADMIN_NOTIFICATION_EMAILS="direction@barkasolutions.org,kouchoumichel@yahoo.fr"

# -------------------------------------------------------------------------
# 5. EXPÉDITION D'EMAILS TRANSITIONNELS (CHOISIR L'UN DES FOURNISSEURS)
# -------------------------------------------------------------------------

# --- OPTION A : Serveur SMTP Standard (Gmail, OVH, Brevo SMTP, etc.) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@barkasolutions.org"
SMTP_PASS=""
SMTP_FROM_NAME="BARKA SOLUTIONS S.A.S"
SMTP_FROM_EMAIL="direction@barkasolutions.org"
SMTP_FROM="BARKA SOLUTIONS S.A.S <direction@barkasolutions.org>"

# --- OPTION B : Resend API (Haute délivrabilité & installation instantanée) ---
# RESEND_API_KEY="re_123456789abcdef"

# --- OPTION C : Brevo / Sendinblue REST API ---
# BREVO_API_KEY="xkeysib-..."

# --- OPTION D : SendGrid REST API ---
# SENDGRID_API_KEY="SG...."

# --- OPTION E : Mailgun REST API ---
# MAILGUN_API_KEY="key-..."
# MAILGUN_DOMAIN="mg.barkasolutions.org"

# -------------------------------------------------------------------------
# 6. STOCKAGE DES FICHIERS EN PRODUCTION SERVERLESS
# -------------------------------------------------------------------------
# Sur Vercel, l'environnement injecte automatiquement VERCEL=1.
# Les fichiers temporaires sont redirigés vers /tmp/uploads.
# Pour un stockage d'archives illimité en production, il est recommandé de relier
# un bucket AWS S3, Cloudflare R2 ou Vercel Blob (consulter docs/PRODUCTION_STORAGE.md).
# S3_BUCKET_NAME=""
# S3_REGION="eu-west-3"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
